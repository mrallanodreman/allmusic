# ── AllMusic — variables de entorno ─────────────────────────────────────────
# RapidAPI (rotación de keys separadas por coma)
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com

# 3ra capa: fallback local yt-dlp (opcional)
YTFALLBACK_URL=
YTFALLBACK_TOKEN=

# Moderador del servidor (obligatorio para /radio/master y moderación)
MODERATOR_KEY=

# JWT de artistas (obligatorio en producción)
JWT_SECRET=

# VirusTotal: clave para validar subidas de audio (obligatoria si VIRUSTOTAL_STRICT=true)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_STRICT=true

# Radio live stream público
RADIO_LIVE_STREAM_URL=

# Puertos / rutas (valores por defecto razonables)
PORT=2426
ALLMUSIC_DATA_DIR=
MAX_CONTENT_LENGTH=52428800
